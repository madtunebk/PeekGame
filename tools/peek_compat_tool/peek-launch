#!/bin/bash
# Steam compatibility-tool entry point for the peek native PE loader.
#   peek-launch <verb> <path/to/game.exe> [args...]
# Supported verbs: run, waitforexitandrun. Every other verb is rejected with exit status 64.
# Steam's environment and working directory are passed through. Steam-runtime
# libraries and the 32-bit overlay are filtered for this 64-bit loader.
#
# Settings (environment, all optional):
#   PEEK_BIN       loader binary (default: ../peek next to this tool's real directory)
#   PEEK_LOG_DIR   log directory (default: ${XDG_STATE_HOME:-~/.local/state}/peek-compat)
#   PEEK_TIMEOUT   seconds before the run is stopped with SIGTERM (default: no limit)
set -u

TOOL_DIR=$(dirname "$(readlink -f "$0")")
# Default loader, in order: peekgame installed beside this tool (the self-contained
# install, independent of any source checkout); dist/peekgame in a PeekGame checkout
# (running straight from tools/peek_compat_tool); then PATH. Override with PEEK_BIN.
if [ -z "${PEEK_BIN:-}" ]; then
    if [ -x "$TOOL_DIR/peekgame" ]; then
        PEEK_BIN="$TOOL_DIR/peekgame"
    elif [ -x "$TOOL_DIR/../../dist/peekgame" ]; then
        PEEK_BIN=$(readlink -f "$TOOL_DIR/../../dist/peekgame")
    else
        PEEK_BIN="peekgame"  # fall back to PATH; peek-launch reports if it is missing
    fi
fi
if [ -z "${PEEKGAME_WINDOWS_DLLS:-}" ]; then
    if [ -d "$TOOL_DIR/windows-dlls" ]; then
        export PEEKGAME_WINDOWS_DLLS="$TOOL_DIR/windows-dlls"
    elif [ -d "$TOOL_DIR/../../dist/windows-dlls" ]; then
        export PEEKGAME_WINDOWS_DLLS=$(readlink -f "$TOOL_DIR/../../dist/windows-dlls")
    fi
fi
LOG_DIR=${PEEK_LOG_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/peek-compat}
EX_USAGE=64 EX_NOINPUT=66 EX_UNAVAILABLE=69 EX_CANTCREAT=73

mkdir -p "$LOG_DIR" || { echo "peek-launch: cannot create log directory $LOG_DIR" >&2; exit $EX_CANTCREAT; }
LOG=$LOG_DIR/steam-${SteamAppId:-noappid}-$(date +%Y%m%d-%H%M%S)-$$.log
ln -sfn "$(basename "$LOG")" "$LOG_DIR/latest.log" 2>/dev/null
# From here on, everything this script and peek print goes to the log. fd 8 keeps Steam's
# original stderr so that refusals are visible there too.
exec 8>&2 >>"$LOG" 2>&1

die() { echo "peek-launch: $2"; echo "peek-launch: $2 (log: $LOG)" >&8; exit "$1"; }

{
    echo "=== peek-launch $(date --iso-8601=seconds)"
    printf 'argv:'; printf ' %q' "$@"; echo
    printf 'cwd: %q\n' "$PWD"
    printf 'tool: %q\npeek: %q\n' "$TOOL_DIR" "$PEEK_BIN"
    echo "steam environment:"
    env | LC_ALL=C sort | grep -E '^(Steam|STEAM_|SteamApp|SteamGame|SteamOverlay|SteamClient|SteamEnv|SteamPath|SDL_|DXVK_|VK_|WAYLAND_DISPLAY|DISPLAY|XDG_SESSION_TYPE|LD_PRELOAD|LD_LIBRARY_PATH)' \
        | sed 's/^/  /'
}

[ $# -ge 1 ] || die $EX_USAGE "missing verb"
verb=$1; shift

case "$verb" in
    run|waitforexitandrun) ;;
    getcompatpath|getnativepath)
        # Proton converts paths between Unix and its Wine drive mapping. peek has no drive
        # mapping (see README), so there is no correct answer to give Steam.
        die $EX_USAGE "verb '$verb' unsupported: peek has no Windows drive mapping" ;;
    runinprefix|destroyprefix)
        die $EX_USAGE "verb '$verb' unsupported: peek uses no Wine prefix" ;;
    *)
        die $EX_USAGE "unknown verb '$verb'" ;;
esac

[ $# -ge 1 ] || die $EX_USAGE "verb '$verb' needs the game executable"
exe=$1; shift

# If Steam launches launcher/idTechLauncher.exe and DOOMEternalx64vk.exe exists, redirect directly to the game
if [ "$(basename "$exe")" = "idTechLauncher.exe" ] && [ -f "$(dirname "$exe")/../DOOMEternalx64vk.exe" ]; then
    exe=$(readlink -f "$(dirname "$exe")/../DOOMEternalx64vk.exe")
    echo "peek-launch: redirecting idTechLauncher.exe -> $exe"
fi

[ -f "$exe" ] || die $EX_NOINPUT "game executable not found: $(printf %q "$exe")"
case "$exe" in
    *.exe|*.EXE|*.Exe) ;;
    *) die $EX_USAGE "not a Windows executable path: $(printf %q "$exe")" ;;
esac
[ -x "$PEEK_BIN" ] || die $EX_UNAVAILABLE "loader not found or not executable: $(printf %q "$PEEK_BIN")"

# waitforexitandrun: Proton waits for the previous session in the prefix to end. The equivalent
# here is one lock per app id, held by the running loader via an inherited descriptor.
# run: take the lock if it is free, but never wait.
lock=$LOG_DIR/.lock-${SteamAppId:-noappid}
exec 9>"$lock" || die $EX_CANTCREAT "cannot open lock file $lock"
if [ "$verb" = waitforexitandrun ]; then
    flock 9 || die $EX_UNAVAILABLE "cannot take lock $lock"
else
    flock -n 9 || echo "peek-launch: note: a previous session for this app id still holds $lock"
fi

# peek is a host binary linked against the system's libraries (libcurl, OpenSSL, ...).
# Steam's LD_LIBRARY_PATH puts the Steam runtime's older copies first, e.g. a libcurl
# without CURL_OPENSSL_4, and the loader then fails to start. Drop those entries;
# the compatible 64-bit overlay and the rest of the environment are kept.
if [ -n "${LD_LIBRARY_PATH:-}" ]; then
    kept=()
    IFS=: read -r -a entries <<< "$LD_LIBRARY_PATH"
    for entry in "${entries[@]}"; do
        case "$entry" in
            ""|*/steam-runtime*|*/pinned_libs_*) ;;
            *) kept+=("$entry") ;;
        esac
    done
    LD_LIBRARY_PATH=$(IFS=:; echo "${kept[*]}")
    export LD_LIBRARY_PATH
    printf 'LD_LIBRARY_PATH for the loader: %q\n' "$LD_LIBRARY_PATH"
fi

# Steam supplies both overlay architectures. The 32-bit .so cannot be loaded
# into this x86-64 loader or its x86-64 children and only repeats ld.so errors.
if [ -n "${LD_PRELOAD:-}" ]; then
    kept_preloads=()
    IFS=: read -r -a preload_entries <<< "$LD_PRELOAD"
    for entry in "${preload_entries[@]}"; do
        case "$entry" in
            */ubuntu12_32/gameoverlayrenderer.so) ;;
            "") ;;
            *) kept_preloads+=("$entry") ;;
        esac
    done
    LD_PRELOAD=$(IFS=:; echo "${kept_preloads[*]}")
    export LD_PRELOAD
    printf 'LD_PRELOAD for the loader: %q\n' "$LD_PRELOAD"
fi

# Detect SteamAppId if omitted from environment
if [ -z "${SteamAppId:-}" ] && [ -n "${STEAM_COMPAT_APP_ID:-}" ] && [ "${STEAM_COMPAT_APP_ID:-}" != "0" ]; then
    export SteamAppId="$STEAM_COMPAT_APP_ID"
fi
if [ -z "${SteamAppId:-}" ]; then
    chk_dir=$(dirname "$exe")
    while [ "$chk_dir" != "/" ] && [ "$chk_dir" != "." ]; do
        if [ -f "$chk_dir/steam_appid.txt" ]; then
            aid=$(tr -d ' \r\n' < "$chk_dir/steam_appid.txt")
            [ -n "$aid" ] && export SteamAppId="$aid" && break
        fi
        chk_dir=$(dirname "$chk_dir")
    done
fi

case "$(basename "$exe")" in
    d3ddriverquery*.exe)
        export DXVK_STATE_CACHE=0
        ;;
esac

# DXVK writes its pipeline state cache to DXVK_STATE_CACHE_PATH, else to the current
# directory. Steam usually sets it to the game's shadercache; when it does not, locate
# the official shadercache or give DXVK a persistent per-app directory so the cache
# survives and is reused across runs instead of scattering a *.dxvk-cache beside the game.
if [ -z "${DXVK_STATE_CACHE_PATH:-}" ]; then
    if [ -n "${STEAM_COMPAT_SHADER_PATH:-}" ] && [ -d "$STEAM_COMPAT_SHADER_PATH" ]; then
        DXVK_STATE_CACHE_PATH="$STEAM_COMPAT_SHADER_PATH/DXVK_state_cache"
    elif [ -n "${SteamAppId:-}" ]; then
        for sc_candidate in \
            "${STEAM_COMPAT_CLIENT_INSTALL_PATH:-$HOME/.steam/debian-installation}/steamapps/shadercache/$SteamAppId" \
            "$HOME/.steam/steam/steamapps/shadercache/$SteamAppId" \
            "$HOME/.local/share/Steam/steamapps/shadercache/$SteamAppId"; do
            if [ -d "$sc_candidate" ]; then
                DXVK_STATE_CACHE_PATH="$sc_candidate/DXVK_state_cache"
                break
            fi
        done
    fi
    if [ -z "${DXVK_STATE_CACHE_PATH:-}" ]; then
        DXVK_STATE_CACHE_PATH="${XDG_DATA_HOME:-$HOME/.local/share}/peekgame/shadercache/${SteamAppId:-standalone}"
    fi
    mkdir -p "$DXVK_STATE_CACHE_PATH" && export DXVK_STATE_CACHE_PATH \
        && printf 'DXVK_STATE_CACHE_PATH: %q\n' "$DXVK_STATE_CACHE_PATH"
fi

# If there is an existing .dxvk-cache (e.g. *-Shipping.dxvk-cache) but the current executable
# name differs (e.g. Palworld.exe), link it so DXVK finds the state cache immediately.
if [ -n "${DXVK_STATE_CACHE_PATH:-}" ] && [ -d "$DXVK_STATE_CACHE_PATH" ]; then
    exe_base=$(basename "$exe" .exe)
    target_cache="$DXVK_STATE_CACHE_PATH/$exe_base.dxvk-cache"
    if [ ! -e "$target_cache" ]; then
        for existing in "$DXVK_STATE_CACHE_PATH"/*.dxvk-cache; do
            if [ -f "$existing" ] && [ "$(basename "$existing")" != "$exe_base.dxvk-cache" ]; then
                ln -sf "$(basename "$existing")" "$target_cache" 2>/dev/null && \
                    echo "peek-launch: linked state cache $exe_base.dxvk-cache -> $(basename "$existing")"
                break
            fi
        done
    fi
fi

cmd=("$PEEK_BIN" "$exe" --run "$@")
[ -n "${PEEK_TIMEOUT:-}" ] && cmd=(timeout --foreground "$PEEK_TIMEOUT" "${cmd[@]}")
printf 'exec:'; printf ' %q' "${cmd[@]}"; echo
echo "=== loader output"
exec 8>&-
# exec keeps the PID Steam started, so Steam's "Stop" and exit tracking reach the loader directly.
exec "${cmd[@]}"
